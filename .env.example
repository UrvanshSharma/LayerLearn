# LayerLearn — Environment Variables
# Copy this to .env and adjust as needed.

# ========== LLM BACKEND SELECTION ==========
# Backend: "gemma" (default, recommended) or "ollama"
LLM_BACKEND=gemma

# ========== GOOGLE GEMINI/GEMMA API (Recommended) ==========
# Get your free API key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=
GEMMA_MODEL=gemini-2.0-flash

# ========== OLLAMA (Fallback/Alternative) ==========
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision

# ========== LLM SETTINGS ==========
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# ========== SPEECH-TO-TEXT ==========
# faster-whisper model size: tiny | base | small | medium | large-v3
STT_MODEL_SIZE=base
STT_LANGUAGE=en

# ========== TEXT-TO-SPEECH ==========
# edge-tts voice options: en-US-AriaNeural, en-US-GuyNeural, etc.
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+20%

# ========== PUSH-TO-TALK ==========
# Key to hold for voice input: space, shift, alt, ctrl, cmd, etc.
PTT_KEY=space

# ========== AGENT SETTINGS ==========
MAX_MEMORY_TURNS=20

# ========== DEBUG MODE ==========
DEBUG=false
